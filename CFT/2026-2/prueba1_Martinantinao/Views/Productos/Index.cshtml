
@model List<prueba1_Martinantinao.Models.Producto>

@{
    ViewData["Title"] = "catalogo";
}

<div class="container mt-4">
    <h1>@ViewData ["Titulo"]</h1>
    <p>Listado interno de productos.</p>
    <table class =" table table-bordered table-striped align-middle">
        <thead class="table-dark">
            <tr>
            <th>Nombre</th>
            <th>Categoria</th>
            <th>Precio</th>
            <th>Stock</th>
            <th>Estado</th>
            <th>Accion</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in Model)
            {
                <tr>
                    <td>@p.Nombre</td>
                    <td>@p.Categoria</td>
                    <td>@p.Precio</td>
                    <td>@p.Stock</td>
                    <td>
                        @if (p.TieneStock())
                        {
                            <span class="badge bg-success">Disponible</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Sin stock</span>
                        }
                    </td>
                    <td>
                        <a asp-controller="Productos"
                           asp-action="Details"
                           asp-route-id="@p.Id"
                           class="btn btn-primary btn-sm">
                            Ver detalle
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>    
